# M1/M2 support only the synthetic, unauthenticated loopback profile.
A2A_LAB_PROFILE=local-demo
A2A_LAB_HOST=127.0.0.1
A2A_LAB_PORT=8100
A2A_LAB_REQUEST_TIMEOUT_SECONDS=5
A2A_LAB_MAX_INPUT_CHARACTERS=1000
A2A_LAB_COORDINATOR_PORT=8101
A2A_LAB_KNOWLEDGE_PORT=8102
A2A_LAB_MAX_PAYLOAD_BYTES=65536
A2A_LAB_MAX_CONCURRENT_REQUESTS=4
A2A_LAB_STARTUP_TIMEOUT_SECONDS=15
A2A_LAB_SHUTDOWN_TIMEOUT_SECONDS=3
